<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsServiceFabricServiceProject>True</IsServiceFabricServiceProject>
    <ServerGarbageCollection>True</ServerGarbageCollection>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>True</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ServiceFabric" Version="11.5.116" />
    <PackageReference Include="Microsoft.ServiceFabric.Data" Version="8.5.116" />
    <PackageReference Include="Microsoft.ServiceFabric.Services" Version="8.5.116" />
    <PackageReference Include="Microsoft.ServiceFabric.Services.Remoting" Version="8.5.116" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TravelPlanner.Interfaces\TravelPlanner.Interfaces.csproj" />
  </ItemGroup>

</Project>
